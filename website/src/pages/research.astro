---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Research: Affective Architectures for SenlightAI";

const contributions = [
  {
    index: "01",
    name: "RLEF",
    desc: "Reinforcement Learning from Emotional Feedback. The reward favors empathy over factual correctness.",
  },
  {
    index: "02",
    name: "VAD latent space",
    desc: "Emotional states become continuous 3D vectors on Valence, Arousal, and Dominance. No discrete labels.",
  },
  {
    index: "03",
    name: "Plutchik routing",
    desc: "Eight discrete primaries run in parallel, classifying intent so the right persona policy fires.",
  },
  {
    index: "04",
    name: "Live sentiment loop",
    desc: "Deployed outputs get re-annotated and flow back into the training pool.",
  },
];

const phases = [
  {
    index: "Phase 01",
    name: "Data & annotation",
    tagline: "Turn raw conversation into a labeled emotional distribution.",
    stages: ["Raw corpora", "VAD annotation −1..1", "Plutchik tags", "Empathetic SFT baseline"],
    body: "Conversation data enters unlabeled. Annotators score each interaction on Valence, Arousal, and Dominance and tag it with a Plutchik category. The model gets fine-tuned to copy that distribution. This is the empathetic baseline.",
  },
  {
    index: "Phase 02",
    name: "Reward & optimization",
    tagline: "Optimize for empathy, not just correctness.",
    stages: ["Sample outputs", "Human ranking", "Affective reward model", "PPO"],
    body: "Outputs are sampled from the baseline and ranked by annotators on empathy and tone. That yields preference data. A learned model scores any new output, and PPO raises the expected affective reward.",
  },
  {
    index: "Phase 03",
    name: "State & deployment",
    tagline: "Track the trajectory, then close the loop.",
    stages: ["Latent state tracking", "Deployment", "Live sentiment loop"],
    body: "At inference the policy holds a running emotional state across turns. Deployed outputs get re-annotated and streamed back into the training pool. The live system runs this loop continually.",
  },
];

const vadRows = [
  { name: "Triumph / Excited", v: "1.0", a: "1.0", d: "1.0", color: "#ff7a17", desc: "Maximum positivity, energy, and control." },
  { name: "Anger / Rage", v: "−1.0", a: "1.0", d: "1.0", color: "#ff6a4d", desc: "Highly negative and active, feeling dominant." },
  { name: "Fear / Panic", v: "−1.0", a: "1.0", d: "−1.0", color: "#7c3aed", desc: "Highly negative and active, feeling completely out of control." },
  { name: "Sadness / Despair", v: "−1.0", a: "−1.0", d: "−1.0", color: "#a0c3ec", desc: "Total loss of positivity, energy, and agency." },
  { name: "Relaxation / Calm", v: "0.8", a: "−0.8", d: "0.5", color: "#ffc285", desc: "Positive, low energy, mild sense of agency." },
  { name: "Boredom / Apathy", v: "−0.5", a: "−0.8", d: "−0.5", color: "#7d8187", desc: "Negative leaning, very low energy, lack of agency." },
  { name: "Surprise", v: "0.2", a: "0.9", d: "−0.5", color: "#c4b5fd", desc: "Sudden spike in energy, momentary loss of control." },
  { name: "Contentment", v: "0.9", a: "−0.4", d: "0.6", color: "#ffffff", desc: "Highly pleasant, calm, secure." },
  { name: "Neutral", v: "0.0", a: "0.0", d: "0.0", color: "#363a3f", desc: "Baseline emotional state." },
];

const primaries = [
  { main: "Joy", opp: "Sadness", color: "#ffc285" },
  { main: "Anger", opp: "Fear", color: "#ff6a4d" },
  { main: "Trust", opp: "Disgust", color: "#a0c3ec" },
  { main: "Surprise", opp: "Anticipation", color: "#c4b5fd" },
];

const matrixRows = [
  {
    stage: "Data annotation",
    vad: "Annotators rate interactions on −1.0 to 1.0 continuous scales, generating dense 3D vectors per turn.",
    plutchik: "Annotators tag user prompts with discrete categories for prompt routing.",
  },
  {
    stage: "Reward function (RLEF)",
    vad: "Penalizes the AI if a response spikes Arousal while Valence is negative.",
    plutchik: "Rewards generating complementary emotional categories based on detected intent.",
  },
  {
    stage: "Inference & routing",
    vad: "Latent emotional state vector is tracked continuously across conversation turns.",
    plutchik: "Discrete intent class selects the empathetic persona policy at inference time.",
  },
];

const sources = [
  {
    title: "Emotional AI Training Architecture",
    kind: "Interactive document",
    desc: "The primary guide: the RLEF pipeline flowchart, the interactive 3D VAD model, Plutchik's wheel, and the integration matrix.",
    href: "/research/the-guide.html",
  },
  {
    title: "3D Visualization of Emotions",
    kind: "Widget source",
    desc: "Rendering source for the 3D visual of emotional states used in the study.",
    href: "/research/3d-visual-of-emotions.html",
  },
  {
    title: "Emotional AI Training Pipeline",
    kind: "Widget source",
    desc: "Rendering source for the RLEF training pipeline flow diagram.",
    href: "/research/emotional-ai-training-pipeline.html",
  },
];
---

<Layout title={title}>
  <Nav />

  <main>
    <!-- Hero -->
    <section class="hero" id="top">
      <div class="container hero-inner">
        <p class="eyebrow">Research &middot; 2026</p>
        <h1 class="display-xl" style="max-width: 900px; margin-bottom: var(--sp-xl)">
          Making a language model react to <span class="serif-em">how you feel</span>.
        </h1>
        <p class="body-lg prose-muted" style="max-width: 640px; margin: 0 0 var(--sp-3xl)">
          A model can be fluent and still miss the point. This study defines how
          a from-scratch transformer like SenlightAI (≈100M params, decoder-only,
          GQA / RoPE / SwiGLU) moves past factual correctness. It maps emotional
          states onto continuous vectors and learns from emotional feedback.
        </p>
        <dl class="hero-stats" style="max-width: 760px">
          <div class="stat">
            <dt class="stat-key">Field</dt>
            <dd class="stat-value" style="margin: 0">Affective computing</dd>
          </div>
          <div class="stat">
            <dt class="stat-key">Method</dt>
            <dd class="stat-value" style="margin: 0">RLEF</dd>
          </div>
          <div class="stat">
            <dt class="stat-key">Representations</dt>
            <dd class="stat-value" style="margin: 0">VAD × Plutchik</dd>
          </div>
          <div class="stat">
            <dt class="stat-key">Target model</dt>
            <dd class="stat-value" style="margin: 0">SenlightAI · 100M</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Abstract -->
    <section class="band band--section">
      <div class="container" style="display: grid; gap: var(--sp-4xl)">
        <div class="research-split">
          <div>
            <p class="eyebrow">Abstract</p>
            <h2 class="display-sm">Correctness is not empathy.</h2>
            <p class="body-md prose-muted" style="margin: 0">
              Standard language-model training optimizes next-token likelihood on
              factual corpora. That signal says nothing about tone, escalation, or
              how the conversation feels. A technical assistant gets judged on
              accuracy alone. An affective AI gets judged on how it made the user
              feel, so it needs a reward tied to affect, a representation it can
              update, and a loop that keeps learning from live use.
            </p>
          </div>
          <div>
            <p class="eyebrow">Key contributions</p>
            <div class="contrib-list">
              {contributions.map((c) => (
                <div class="contrib-item">
                  <span class="contrib-index">{c.index}</span>
                  <div>
                    <h3 class="display-xs" style="margin-bottom: var(--sp-xxs)">{c.name}</h3>
                    <p class="body-sm prose-muted" style="margin: 0">{c.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Methodology -->
    <section id="methodology" class="band band--section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Methodology</p>
          <h2 class="display-md">The RLEF training architecture.</h2>
          <p class="body-lg prose-muted" style="margin: 0">
            Reinforcement Learning from Emotional Feedback runs in three phases
            across the SenlightAI stack. Python tooling handles annotation,
            <span class="mono">train.py</span> runs SFT and PPO, and the Rust
            inference engine closes the live loop.
          </p>
        </header>

        <div class="phase-grid">
          {phases.map((p) => (
            <article class="card phase-card">
              <div class="phase-index">{p.index}</div>
              <h3 class="display-xs" style="margin: 0 0 var(--sp-sm)">{p.name}</h3>
              <p class="phase-tagline">{p.tagline}</p>
              <ul class="phase-stages">
                {p.stages.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <p class="body-sm prose-muted" style="margin: 0">{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- VAD reference table -->
    <section id="vad-data" class="band band--section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Appendix A · VAD Reference Space</p>
          <h2 class="display-md">Emotional centroids in continuous coordinates.</h2>
          <p class="body-lg prose-muted" style="margin: 0">
            The anchors used for annotation and reward shaping. Nearest-centroid
            distance in this space is the model's affective state estimate.
          </p>
        </header>

        <div class="table-wrap vad-table" style="overflow-x: auto">
          <table class="matrix-table">
            <thead>
              <tr>
                <th scope="col">Emotion</th>
                <th scope="col">Valence</th>
                <th scope="col">Arousal</th>
                <th scope="col">Dominance</th>
                <th scope="col">Semantics</th>
              </tr>
            </thead>
            <tbody>
              {vadRows.map((r) => (
                <tr>
                  <td class="stage">
                    <span style="display:inline-flex; align-items:center; gap: var(--sp-sm)">
                      <span class="vad-chip" style={`background: ${r.color}`} aria-hidden="true"></span>
                      {r.name}
                    </span>
                  </td>
                  <td class="mono">{r.v}</td>
                  <td class="mono">{r.a}</td>
                  <td class="mono">{r.d}</td>
                  <td>{r.desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="body-sm" style="color: var(--body-mid); margin-top: var(--sp-lg)">
          The model computes the distance from the current state to every centroid
          and reports the closest one. That is its dominant emotion for the turn.
        </p>
      </div>
    </section>

    <!-- Plutchik taxonomy -->
    <section id="plutchik-taxonomy" class="band band--section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Appendix B · Plutchik Taxonomy</p>
          <h2 class="display-md">Discrete categories, run in parallel.</h2>
        </header>

        <div class="plutchik-grid" style="grid-template-columns: repeat(2, 1fr); gap: var(--sp-md)">
          {primaries.map((p) => (
            <div class="plutchik-card">
              <span class="chip" style={`background: ${p.color}`} aria-hidden="true"></span>
              <p class="pmain" style="margin:0 0 2px">{p.main}</p>
              <p class="popp" style="margin:0">{p.opp}</p>
            </div>
          ))}
        </div>

        <div class="card" style="margin-top: var(--sp-2xl); padding: var(--sp-xl)">
          <p class="mono" style="color: var(--accent-deep); margin: 0 0 var(--sp-sm)">Intensity mapping</p>
          <div class="intensity-row">
            <span class="intensity-chip">Annoyance</span>
            <span class="intensity-arrow" aria-hidden="true">→</span>
            <span class="intensity-chip is-hot">Anger</span>
            <span class="intensity-arrow" aria-hidden="true">→</span>
            <span class="intensity-chip is-hot">Rage</span>
            <span class="intensity-arrow" aria-hidden="true">·</span>
            <span class="intensity-chip">Concern</span>
            <span class="intensity-arrow" aria-hidden="true">→</span>
            <span class="intensity-chip">Fear</span>
            <span class="intensity-arrow" aria-hidden="true">→</span>
            <span class="intensity-chip is-hot">Terror</span>
          </div>
          <p class="body-sm" style="color: var(--body-mid); margin: var(--sp-lg) 0 0">
            Emotions intensify toward the wheel's core, and the scale doubles as
            escalation detection. It stops the model from amplifying distress.
          </p>
        </div>
      </div>
    </section>

    <!-- Integration matrix -->
    <section id="matrix" class="band band--section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Framework Integration Matrix</p>
          <h2 class="display-md">Two lenses, one pipeline.</h2>
        </header>
        <div class="table-wrap" style="overflow-x: auto">
          <table class="matrix-table">
            <thead>
              <tr>
                <th scope="col">Training Stage</th>
                <th scope="col">VAD Model Application</th>
                <th scope="col">Plutchik's Application</th>
              </tr>
            </thead>
            <tbody>
              {matrixRows.map((r) => (
                <tr>
                  <td class="stage">{r.stage}</td>
                  <td>{r.vad}</td>
                  <td>{r.plutchik}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Sources -->
    <section id="sources" class="band band--section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">References</p>
          <h2 class="display-md">Source documents.</h2>
        </header>
        <div class="src-grid">
          {sources.map((s) => (
            <a class="card src-card" href={s.href}>
              <div class="src-kind">{s.kind}</div>
              <h3 class="display-xs" style="margin: 0 0 var(--sp-sm)">{s.title}</h3>
              <p class="body-sm prose-muted" style="margin: 0 0 var(--sp-xl)">{s.desc}</p>
              <span class="mono" style="color: var(--ink)">Open document →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .research-split {
    display: grid;
    gap: var(--sp-4xl);
  }

  @media (min-width: 900px) {
    .research-split {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-4xl) calc(var(--sp-4xl) * 2);
    }
  }

  .contrib-list {
    display: grid;
    gap: var(--sp-md);
  }

  .contrib-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--sp-md);
    padding-bottom: var(--sp-md);
    border-bottom: 1px solid var(--hairline);
  }

  .contrib-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .contrib-index {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.2px;
    color: var(--body-mid);
    padding-top: 4px;
  }

  .phase-grid {
    display: grid;
    gap: var(--sp-lg);
  }

  @media (min-width: 900px) {
    .phase-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .phase-card {
    padding: var(--sp-xl);
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .phase-index {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--body-mid);
  }

  .phase-tagline {
    color: var(--body);
    margin: 0;
  }

  .phase-stages {
    list-style: none;
    margin: 0 0 var(--sp-lg);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
  }

  .phase-stages li {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--body);
    background: var(--canvas-soft);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    padding: var(--sp-xs) var(--sp-sm);
  }

  .vad-chip {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    flex: none;
  }

  .src-grid {
    display: grid;
    gap: var(--sp-lg);
  }

  @media (min-width: 900px) {
    .src-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .src-card {
    display: flex;
    flex-direction: column;
    padding: var(--sp-xl);
    transition: border-color 0.25s var(--ease);
  }

  .src-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
  }

  .src-kind {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--body-mid);
    margin-bottom: var(--sp-xl);
  }
</style>