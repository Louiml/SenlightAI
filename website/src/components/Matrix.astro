---
const rows = [
  {
    stage: "Data annotation",
    vad: "Annotators rate every turn from −1.0 to 1.0, producing a 3D vector.",
    plutchik: "Annotators tag each prompt with a category for routing.",
  },
  {
    stage: "Reward function (RLEF)",
    vad: "Penalizes a response that spikes Arousal while Valence stays negative.",
    plutchik: "Rewards generating complementary categories based on the detected intent.",
  },
  {
    stage: "Inference & routing",
    vad: "Tracks the emotional state vector continuously across turns.",
    plutchik: "Picks the empathetic persona policy from the detected intent class.",
  },
];
---

<section id="matrix" class="band band--section">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Framework Integration Matrix</p>
      <h2 class="display-md">Two lenses, one pipeline.</h2>
      <p class="body-lg prose-muted" style="margin:0">
        VAD and Plutchik are not in competition. Each is applied where it fits,
        on every stage of training.
      </p>
    </header>

    <div class="table-wrap">
      <table class="matrix-table">
        <thead>
          <tr>
            <th scope="col">Training Stage</th>
            <th scope="col">VAD Model Application</th>
            <th scope="col">Plutchik's Application</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <td class="stage">{r.stage}</td>
                <td>{r.vad}</td>
                <td>{r.plutchik}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>