---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path
            d="M6.5 8.8C6.5 5.6 17.5 5.6 17.5 8.8C17.5 12.3 8.5 11 8.5 14.8C8.5 17.6 17.5 16.8 17.5 13.9"
            stroke="url(#sfg)"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="6.5" cy="8.8" r="1.15" fill="#ffffff" />
          <defs>
            <linearGradient id="sfg" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#ffb14e" />
              <stop offset="0.5" stop-color="#ff8a1e" />
              <stop offset="1" stop-color="#ff5a00" />
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="brand-word">Senlight</span><span class="brand-ai">AI</span>
    </div>

    <p class="footer-meta" style="margin: 0">
      © {year} SenlightAI. Affective AI research.
    </p>

    <div class="footer-meta" style="display: flex; gap: var(--sp-2xl)">
      <a class="nav-link" href="#pipeline">Pipeline</a>
      <a class="nav-link" href="#vad-model">VAD Space</a>
      <a class="nav-link" href="/research">Research</a>
    </div>
  </div>
</footer>