---
// Interactive 3D Valence, Arousal, Dominance space.
// Data + semantics sourced from research/TheGuide.html
// Reference emotions and nearest-centroid math preserved.
---

<section id="vad-model" class="band band--section">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">3D VAD Space</p>
      <h2 class="display-md">A continuous space for every feeling.</h2>
      <p class="body-lg prose-muted" style="margin:0">
        Emotions are coordinates, not labels. Valence, arousal, and dominance
        put any mental state somewhere between −1 and 1 on three axes. Drag the
        sliders and the point moves with them, and the nearest of 46 reference
        emotions is reported live. Click any labeled point to jump the state
        straight to it.
      </p>
    </header>

    <div class="vad-grid">
      <div class="card vad-controls">
        <div class="vad-slider-block">
          <div class="vad-slider-head">
            <span class="vad-slider-name">Valence</span>
            <span class="vad-slider-axis">AXIS X</span>
            <span class="vad-slider-value" id="vadValV">0.00</span>
          </div>
          <input type="range" class="vad-range vad-range--v" id="vadRangeV" min="-1" max="1" step="0.05" value="0" aria-label="Valence" />
          <div class="vad-slider-scale">
            <span>Despair</span>
            <span>Pleasantness</span>
            <span>Joy</span>
          </div>
        </div>

        <div class="vad-slider-block">
          <div class="vad-slider-head">
            <span class="vad-slider-name">Arousal</span>
            <span class="vad-slider-axis">AXIS Y</span>
            <span class="vad-slider-value" id="vadValA">0.00</span>
          </div>
          <input type="range" class="vad-range vad-range--a" id="vadRangeA" min="-1" max="1" step="0.05" value="0" aria-label="Arousal" />
          <div class="vad-slider-scale">
            <span>Boredom</span>
            <span>Activation</span>
            <span>Rage</span>
          </div>
        </div>

        <div class="vad-slider-block">
          <div class="vad-slider-head">
            <span class="vad-slider-name">Dominance</span>
            <span class="vad-slider-axis">AXIS Z</span>
            <span class="vad-slider-value" id="vadValD">0.00</span>
          </div>
          <input type="range" class="vad-range vad-range--d" id="vadRangeD" min="-1" max="1" step="0.05" value="0" aria-label="Dominance" />
          <div class="vad-slider-scale">
            <span>Fear</span>
            <span>Agency</span>
            <span>In control</span>
          </div>
        </div>

        <div class="vad-hero">
          <p class="vad-hero-label">Nearest Emotional Centroid</p>
          <div class="vad-hero-name" id="vadEmotion">Neutral</div>
          <p class="vad-hero-desc" id="vadEmotionDesc">Baseline emotional state.</p>
        </div>
      </div>

      <div class="vad-plot-wrap" id="vadPlot">
        <canvas id="vadCanvas" aria-label={`Interactive 3D plot of the Valence-Arousal-Dominance emotional space. Drag to rotate.`}></canvas>
        <span class="vad-plot-hint">DRAG TO ROTATE &middot; CLICK A POINT TO JUMP</span>
      </div>
    </div>
  </div>
</section>

<style>
  .vad-range--v {
    background: linear-gradient(90deg, var(--hairline-strong), var(--accent-soft) 50%, var(--accent));
  }
  .vad-range--a {
    background: linear-gradient(90deg, var(--hairline-strong), var(--accent-soft) 50%, var(--accent-deep));
  }
  .vad-range--d {
    background: linear-gradient(90deg, var(--hairline-strong), var(--accent-soft) 50%, var(--ink));
  }
</style>

<script>
  // Reference emotions: 9 core centroids plus sub-emotions around them.
  // Coordinates are Valence (x, pleasantness), Arousal (y, activation),
  // Dominance (z, control), all on [−1, 1].
  const EMOTIONS = [
    // Core: the 9 reference centroids
    { name: "Triumph / Excited", v: 1.0, a: 1.0, d: 1.0, color: "#ff7a17", family: "Joy", primary: true, desc: "Maximum positivity, energy, and control." },
    { name: "Anger / Rage", v: -1.0, a: 1.0, d: 1.0, color: "#ff5252", family: "Anger", primary: true, desc: "Highly negative and active, feeling dominant." },
    { name: "Fear / Panic", v: -1.0, a: 1.0, d: -1.0, color: "#b06bff", family: "Fear", primary: true, desc: "Negative and active, feeling utterly out of control." },
    { name: "Sadness / Despair", v: -1.0, a: -1.0, d: -1.0, color: "#6ea8ff", family: "Sadness", primary: true, desc: "Total loss of positivity, energy, and agency." },
    { name: "Relaxation / Calm", v: 0.8, a: -0.8, d: 0.5, color: "#37d0a5", family: "Calm", primary: true, desc: "Positive, low energy, mild sense of agency." },
    { name: "Boredom / Apathy", v: -0.5, a: -0.8, d: -0.5, color: "#8a8f9b", family: "Apathy", primary: true, desc: "Negative-leaning, drained, little agency." },
    { name: "Surprise", v: 0.2, a: 0.9, d: -0.5, color: "#35c3e0", family: "Surprise", primary: true, desc: "Sudden spike in energy, moment of lost control." },
    { name: "Contentment", v: 0.9, a: -0.4, d: 0.6, color: "#68d98a", family: "Calm", primary: true, desc: "Highly pleasant, calm, secure." },
    { name: "Neutral", v: 0.0, a: 0.0, d: 0.0, color: "#ffffff", family: "Neutral", primary: true, desc: "Baseline emotional state." },

    // Joy family
    { name: "Joy", v: 0.85, a: 0.55, d: 0.5, color: "#ffd273", family: "Joy", desc: "Bright, warm, and engaged." },
    { name: "Elation", v: 0.8, a: 0.8, d: 0.55, color: "#ffc24d", family: "Joy", desc: "A burst of high, rising good mood." },
    { name: "Delight", v: 0.9, a: 0.45, d: 0.55, color: "#ffdf8f", family: "Joy", desc: "Pleasure at something just happening." },
    { name: "Excitement", v: 0.6, a: 0.9, d: 0.4, color: "#ffb02e", family: "Joy", desc: "High-energy anticipation, leaning forward." },
    { name: "Enthusiasm", v: 0.6, a: 0.7, d: 0.35, color: "#ffc966", family: "Joy", desc: "Warm interest and readiness to act." },
    { name: "Hope", v: 0.5, a: 0.2, d: 0.25, color: "#c8f27a", family: "Joy", desc: "Looking up, not there yet." },

    // Anger family
    { name: "Annoyance", v: -0.35, a: 0.3, d: 0.1, color: "#ff9b6b", family: "Anger", desc: "A low, buzzing irritation." },
    { name: "Frustration", v: -0.6, a: 0.5, d: 0.15, color: "#ff8a5c", family: "Anger", desc: "Blocked, with nowhere to go." },
    { name: "Irritation", v: -0.4, a: 0.45, d: 0.2, color: "#ffa075", family: "Anger", desc: "Rising impatience." },
    { name: "Hostility", v: -0.85, a: 0.85, d: 0.7, color: "#ff4a4a", family: "Anger", desc: "Ready for a fight, feels in control." },
    { name: "Contempt", v: -0.6, a: 0.15, d: 0.55, color: "#ffb28f", family: "Anger", desc: "Cold dismissal from a higher position." },

    // Fear family
    { name: "Anxiety", v: -0.6, a: 0.6, d: -0.5, color: "#9d4fff", family: "Fear", desc: "A restless, uncertain dread." },
    { name: "Worry", v: -0.4, a: 0.35, d: -0.3, color: "#b56bff", family: "Fear", desc: "Chewing on something that could go wrong." },
    { name: "Nervousness", v: -0.3, a: 0.65, d: -0.4, color: "#a959ff", family: "Fear", desc: "Jittery, alert, on edge." },
    { name: "Terror", v: -1.0, a: 0.85, d: -0.85, color: "#7733e0", family: "Fear", desc: "Overwhelming fear with no way out." },
    { name: "Dread", v: -0.8, a: 0.5, d: -0.5, color: "#8a3fff", family: "Fear", desc: "A heavy sense that something bad is coming." },
    { name: "Unease", v: -0.35, a: 0.25, d: -0.2, color: "#ae8bff", family: "Fear", desc: "Something feels slightly off." },

    // Sadness family
    { name: "Sorrow", v: -0.75, a: -0.5, d: -0.4, color: "#5f9bff", family: "Sadness", desc: "Quiet grief, low but present." },
    { name: "Grief", v: -0.9, a: -0.65, d: -0.8, color: "#4a86ff", family: "Sadness", desc: "Deep loss, heavy and consuming." },
    { name: "Loneliness", v: -0.7, a: -0.45, d: -0.5, color: "#6ea8ff", family: "Sadness", desc: "Isolated and reaching for connection." },
    { name: "Disappointment", v: -0.5, a: -0.3, d: -0.2, color: "#6fa4ff", family: "Sadness", desc: "Let down by how things turned out." },
    { name: "Melancholy", v: -0.6, a: -0.55, d: -0.3, color: "#7aa8ff", family: "Sadness", desc: "A soft, reflective sadness." },

    // Calm / trust family
    { name: "Serenity", v: 0.6, a: -0.6, d: 0.5, color: "#49d79b", family: "Calm", desc: "Settled and easy breathing." },
    { name: "Peace", v: 0.5, a: -0.7, d: 0.4, color: "#43d98f", family: "Calm", desc: "Quiet, no friction." },
    { name: "Gratitude", v: 0.75, a: -0.2, d: 0.45, color: "#8fe891", family: "Calm", desc: "Warm appreciation, gently felt." },
    { name: "Trust", v: 0.7, a: -0.1, d: 0.55, color: "#58cf6b", family: "Calm", desc: "Open and confident in others." },
    { name: "Admiration", v: 0.85, a: 0.35, d: 0.6, color: "#5fd477", family: "Calm", desc: "Respect lifted by a little wonder." },
    { name: "Awe", v: 0.6, a: 0.7, d: 0.0, color: "#7be0a0", family: "Calm", desc: "Smallness before something vast." },

    // Apathy family
    { name: "Listlessness", v: -0.3, a: -0.7, d: -0.4, color: "#7e8491", family: "Apathy", desc: "Drained, no spark to move." },
    { name: "Detachment", v: -0.3, a: -0.5, d: -0.1, color: "#8a8f9b", family: "Apathy", desc: "Watching from a distance." },
    { name: "Lethargy", v: -0.45, a: -0.6, d: -0.5, color: "#757b88", family: "Apathy", desc: "Too heavy to start anything." },

    // Surprise family
    { name: "Astonishment", v: 0.1, a: 0.95, d: -0.4, color: "#35c3e0", family: "Surprise", desc: "Wide-open, caught off guard." },
    { name: "Wonder", v: 0.5, a: 0.6, d: 0.1, color: "#46d0e8", family: "Surprise", desc: "Curious delight at the unexpected." },
    { name: "Shock", v: 0.0, a: 0.9, d: -0.7, color: "#2fb9d6", family: "Surprise", desc: "Taken completely off balance." },

    // Disgust family
    { name: "Disgust", v: -0.6, a: 0.1, d: 0.5, color: "#b0764a", family: "Disgust", desc: "A push away from something repellant." },
    { name: "Revulsion", v: -0.75, a: 0.25, d: 0.5, color: "#a56a3e", family: "Disgust", desc: "Strong recoil, physically felt." },
    { name: "Loathing", v: -0.85, a: 0.3, d: 0.55, color: "#96592f", family: "Disgust", desc: "Deep contempt mixed with nausea." },
  ];

  const wrap = document.getElementById("vadPlot");
  const canvas = document.getElementById("vadCanvas");
  const ctx = canvas.getContext("2d");
  const sliderV = document.getElementById("vadRangeV");
  const sliderA = document.getElementById("vadRangeA");
  const sliderD = document.getElementById("vadRangeD");
  const valV = document.getElementById("vadValV");
  const valA = document.getElementById("vadValA");
  const valD = document.getElementById("vadValD");
  const emotionEl = document.getElementById("vadEmotion");
  const emotionDesc = document.getElementById("vadEmotionDesc");
  const FONT_MONO = "'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace";

  if (!wrap || !ctx) throw new Error("VAD plot could not initialize");

  let rotX = 0.42;
  let rotY = -0.62;
  let dragging = false;
  let lastX = 0;
  let lastY = 0;
  let w = 0;
  let h = 0;
  let dpr = 1;

  function resize() {
    const rect = wrap.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = rect.width;
    h = rect.height;
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  }

  function project(v, a, d) {
    const cy = Math.cos(rotY), sy = Math.sin(rotY);
    const cx = Math.cos(rotX), sx = Math.sin(rotX);
    const X = v * cy + d * sy;
    const Z = -v * sy + d * cy;
    const Y = a * cx - Z * sx;
    const Z2 = a * sx + Z * cx;
    return { x: X, y: Y, z: Z2 };
  }

  function draw() {
    if (!w || !h) return;
    ctx.clearRect(0, 0, w, h);
    const scale = Math.min(w, h) * 0.3;
    const cx = w / 2;
    const cy = h / 2;
    const to = (p) => ({ sx: cx + p.x * scale, sy: cy - p.y * scale });

    // Cube edges (corners of [-1,1]^3, connected across one-bit differences)
    const corners = [];
    for (let i = 0; i < 8; i++) {
      corners.push({ x: (i & 1) ? 1 : -1, y: (i & 2) ? 1 : -1, z: (i & 4) ? 1 : -1 });
    }
    const edges = [];
    for (let i = 0; i < 8; i++) {
      for (let j = i + 1; j < 8; j++) {
        if ((i ^ j) === 1 || (i ^ j) === 2 || (i ^ j) === 4) edges.push([corners[i], corners[j]]);
      }
    }

    ctx.lineWidth = 1;
    ctx.strokeStyle = "rgba(31,26,19,0.16)";
    ctx.beginPath();
    for (const [a, b] of edges) {
      const p = to(project(a.x, a.y, a.z));
      const q = to(project(b.x, b.y, b.z));
      ctx.moveTo(p.sx, p.sy);
      ctx.lineTo(q.sx, q.sy);
    }
    ctx.stroke();

    // Axis lines + mono labels
    const axes = [
      { pts: [project(-1.35, 0, 0), project(1.35, 0, 0)], label: "V", from: -1 },
      { pts: [project(0, -1.35, 0), project(0, 1.35, 0)], label: "A", from: -1 },
      { pts: [project(0, 0, -1.35), project(0, 0, 1.35)], label: "D", from: -1 },
    ];
    ctx.font = `600 11px ${FONT_MONO}`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    for (const ax of axes) {
      const p1 = to(ax.pts[0]);
      const p2 = to(ax.pts[1]);
      ctx.strokeStyle = "rgba(31,26,19,0.28)";
      ctx.beginPath();
      ctx.moveTo(p1.sx, p1.sy);
      ctx.lineTo(p2.sx, p2.sy);
      ctx.stroke();
      // positive end label
      ctx.fillStyle = "rgba(31,26,19,0.85)";
      ctx.fillText(ax.label, p2.sx + (p2.sx >= cx ? 10 : -10), p2.sy + (p2.sy >= cy ? 10 : -10));
      // +1/-1 tick labels
      ctx.font = `9px ${FONT_MONO}`;
      ctx.fillStyle = "rgba(138,125,107,0.9)";
      for (const t of [0.5, -0.5]) {
        let tp;
        if (ax.label === "V") tp = to(project(t, 0, 0));
        else if (ax.label === "A") tp = to(project(0, t, 0));
        else tp = to(project(0, 0, t));
        ctx.fillText(t.toFixed(1).replace("-", "−"), tp.sx, tp.sy + 16);
      }
      ctx.font = `600 11px ${FONT_MONO}`;
    }

    // Family cluster halos: soft glow at each family's mean coordinate
    const familyMean = {};
    for (const e of EMOTIONS) {
      if (!familyMean[e.family]) familyMean[e.family] = { n: 0, v: 0, a: 0, d: 0, color: e.color };
      const f = familyMean[e.family];
      f.n += 1;
      f.v += e.v;
      f.a += e.a;
      f.d += e.d;
    }
    ctx.globalCompositeOperation = "lighter";
    for (const f of Object.values(familyMean)) {
      const mean = project(f.v / f.n, f.a / f.n, f.d / f.n);
      const s = to(mean);
      const g = ctx.createRadialGradient(s.sx, s.sy, 4, s.sx, s.sy, 120);
      g.addColorStop(0, f.color + "22");
      g.addColorStop(1, f.color + "00");
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(s.sx, s.sy, 120, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalCompositeOperation = "source-over";

    // Emotion points, painter-sorted back to front.
    // Sub-emotions are small and dimmed; core centroids are large and labeled.
    const pts = EMOTIONS.map((e) => ({ e, p: project(e.v, e.a, e.d) }));
    pts.sort((x, y) => x.p.z - y.p.z);
    ctx.textBaseline = "middle";

    for (const { e, p } of pts) {
      const s = to(p);
      const depth = (p.z + 1) / 2;
      const alpha = 0.45 + depth * 0.55;
      const isCore = e.primary;
      const r = isCore ? 4.5 : 2.6;

      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.arc(s.sx, s.sy, r, 0, Math.PI * 2);
      ctx.fillStyle = e.color;
      ctx.fill();

      if (isCore) {
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(s.sx, s.sy, r, 0, Math.PI * 2);
        ctx.strokeStyle = "rgba(41,34,24,0.55)";
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      // Label cores; label subs only when they are not crowded behind others
      ctx.font = isCore ? `600 9px ${FONT_MONO}` : `8px ${FONT_MONO}`;
      ctx.fillStyle = isCore ? "rgba(31,26,19,0.95)" : "rgba(84,74,60,0.8)";
      ctx.textAlign = "left";
      ctx.fillText(e.name.toUpperCase(), s.sx + (isCore ? 9 : 6), s.sy);
      ctx.font = `600 9px ${FONT_MONO}`;
    }
    ctx.globalAlpha = 1;

    // Current state + nearest connector
    const cur = {
      v: parseFloat(sliderV.value),
      a: parseFloat(sliderA.value),
      d: parseFloat(sliderD.value),
    };
    let nearest = EMOTIONS[0];
    let best = Infinity;
    for (const e of EMOTIONS) {
      const dist = (e.v - cur.v) ** 2 + (e.a - cur.a) ** 2 + (e.d - cur.d) ** 2;
      if (dist < best) {
        best = dist;
        nearest = e;
      }
    }

    const sp = to(project(cur.v, cur.a, cur.d));
    const np = to(project(nearest.v, nearest.a, nearest.d));
    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = nearest.color;
    ctx.globalAlpha = 0.6;
    ctx.beginPath();
    ctx.moveTo(sp.sx, sp.sy);
    ctx.lineTo(np.sx, np.sy);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.globalAlpha = 1;

    ctx.shadowColor = "rgba(184,64,10,0.4)";
    ctx.shadowBlur = 14;
    ctx.beginPath();
    ctx.arc(sp.sx, sp.sy, 7, 0, Math.PI * 2);
    ctx.fillStyle = "#1f1a13";
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.beginPath();
    ctx.arc(sp.sx, sp.sy, 11, 0, Math.PI * 2);
    ctx.strokeStyle = "rgba(184,64,10,0.6)";
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.font = `600 10px ${FONT_MONO}`;
    ctx.textAlign = "center";
    ctx.fillStyle = "#1f1a13";
    ctx.fillText("STATE", sp.sx, sp.sy - 18);
  }

  function update() {
    const v = parseFloat(sliderV.value);
    const a = parseFloat(sliderA.value);
    const d = parseFloat(sliderD.value);

    valV.textContent = v.toFixed(2);
    valA.textContent = a.toFixed(2);
    valD.textContent = d.toFixed(2);

    let nearest = EMOTIONS[0];
    let best = Infinity;
    for (const e of EMOTIONS) {
      const dist = (e.v - v) ** 2 + (e.a - a) ** 2 + (e.d - d) ** 2;
      if (dist < best) {
        best = dist;
        nearest = e;
      }
    }

    emotionEl.textContent = nearest.primary ? nearest.name : `${nearest.family} · ${nearest.name}`;
    emotionEl.style.color = nearest.color;
    emotionDesc.textContent = nearest.desc;
    draw();
  }

  sliderV.addEventListener("input", update);
  sliderA.addEventListener("input", update);
  sliderD.addEventListener("input", update);

  let pressX = 0;
  let pressY = 0;
  wrap.addEventListener("pointerdown", (e) => {
    dragging = true;
    lastX = e.clientX;
    lastY = e.clientY;
    pressX = e.clientX;
    pressY = e.clientY;
    wrap.setPointerCapture(e.pointerId);
  });

  wrap.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    rotY += (e.clientX - lastX) * 0.008;
    rotX = Math.max(-1.2, Math.min(1.2, rotX + (e.clientY - lastY) * 0.008));
    lastX = e.clientX;
    lastY = e.clientY;
    draw();
  });

  const endDrag = (e) => {
    // Only treat as a click if the pointer barely moved
    const moved = Math.hypot(e.clientX - pressX, e.clientY - pressY);
    if (!dragging || moved < 6) {
      pickAt(e.clientX, e.clientY);
    }
    dragging = false;
    try {
      wrap.releasePointerCapture(e.pointerId);
    } catch (_) {}
  };
  wrap.addEventListener("pointerup", endDrag);
  wrap.addEventListener("pointercancel", endDrag);

  // Click a point to move the state there
  function pickAt(clientX, clientY) {
    if (!w || !h) return;
    const rect = wrap.getBoundingClientRect();
    const x = clientX - rect.left;
    const y = clientY - rect.top;
    const scale = Math.min(w, h) * 0.3;
    const cx = w / 2;
    const cy = h / 2;
    const to = (p) => ({ sx: cx + p.x * scale, sy: cy - p.y * scale });

    let hit = null;
    let bestScreen = Infinity;
    for (const e of EMOTIONS) {
      const s = to(project(e.v, e.a, e.d));
      const dist = Math.hypot(s.sx - x, s.sy - y);
      if (dist < bestScreen && dist < 24) {
        bestScreen = dist;
        hit = e;
      }
    }
    if (!hit) return;
    sliderV.value = String(hit.v);
    sliderA.value = String(hit.a);
    sliderD.value = String(hit.d);
    update();
  }

  const ro = new ResizeObserver(resize);
  ro.observe(wrap);
  window.addEventListener("resize", resize);

  resize();
  update();
</script>