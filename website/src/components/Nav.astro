---
const isResearch = Astro.url.pathname.startsWith("/research");
const isAei = Astro.url.pathname.startsWith("/aei");
const offHome = isResearch || isAei;

const plain = [
  { label: "Pipeline", to: offHome ? "/#pipeline" : "#pipeline" },
  { label: "3D VAD Space", to: offHome ? "/#vad-model" : "#vad-model" },
  { label: "Plutchik", to: offHome ? "/#plutchik" : "#plutchik" },
];

const menus = [
  {
    label: "What is AEI?",
    active: isAei,
    to: "/aei",
    subs: [
      { label: "Overview", h: "" },
      { label: "The Idea", h: "#definition" },
      { label: "Inside the Model", h: "#mechanism" },
      { label: "Building Blocks", h: "#building-blocks" },
      { label: "Boundaries", h: "#boundaries" },
      { label: "Why It Matters", h: "#why" },
    ],
  },
  {
    label: "Research",
    active: isResearch,
    to: "/research",
    subs: [
      { label: "Overview", h: "" },
      { label: "Methodology", h: "#methodology" },
      { label: "VAD Reference Space", h: "#vad-data" },
      { label: "Plutchik Taxonomy", h: "#plutchik-taxonomy" },
      { label: "Integration Matrix", h: "#matrix" },
      { label: "Source Documents", h: "#sources" },
    ],
  },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a class="nav-brand" href="/" aria-label="SenlightAI home">
      <span class="brand-mark" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path
            d="M6.5 8.8C6.5 5.6 17.5 5.6 17.5 8.8C17.5 12.3 8.5 11 8.5 14.8C8.5 17.6 17.5 16.8 17.5 13.9"
            stroke="url(#sg)"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="6.5" cy="8.8" r="1.15" fill="#ffffff" />
          <defs>
            <linearGradient id="sg" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#ffb14e" />
              <stop offset="0.5" stop-color="#ff8a1e" />
              <stop offset="1" stop-color="#c2410c" />
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="brand-word">Senlight</span><span class="brand-ai">AI</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links">
        {
          plain.map((l) => (
            <li class="nav-item">
              <a class="nav-link" href={l.to}>{l.label}</a>
            </li>
          ))
        }
        {
          menus.map((m, i) => (
            <li class="nav-item">
              <button
                class="nav-item-button"
                type="button"
                aria-expanded="false"
                aria-controls={`navmenu-${i}`}
              >
                {m.label}
                <svg class="nav-chevron" width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul class="nav-dropdown" id={`navmenu-${i}`}>
                {
                  m.subs.map((s) => (
                    <li>
                      <a class="nav-sublink" href={m.to + s.h}>{s.label}</a>
                    </li>
                  ))
                }
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-cta">
      <a class="btn btn--sm" href={offHome ? "/#vad-model" : "#vad-model"}>Launch App</a>
    </div>
  </div>
</header>

<script>
  const buttons = document.querySelectorAll(".nav-item-button");
  const menuIds = new Set();
  buttons.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = btn.getAttribute("aria-expanded") === "true";
      buttons.forEach((b) => b.setAttribute("aria-expanded", "false"));
      btn.setAttribute("aria-expanded", String(!open));
      if (btn.getAttribute("aria-controls")) menuIds.add(btn.getAttribute("aria-controls"));
    });
  });

  document.addEventListener("click", () => {
    if (!buttons.length) return;
    const anyOpen = Array.from(buttons).some((b) => b.getAttribute("aria-expanded") === "true");
    if (anyOpen) buttons.forEach((b) => b.setAttribute("aria-expanded", "false"));
  });
</script>