---
const spec = [
  { key: "Reward signal", value: "RLEF — reinforcement learning from emotional feedback" },
  { key: "Representation", value: "3D VAD (Valence, Arousal, Dominance)" },
  { key: "Discrete taxonomy", value: "8 Plutchik primaries" },
  { key: "Reference points", value: "46 labelled states in the VAD space" },
  { key: "Model", value: "SenlightAI · decoder-only, ≈100M parameters" },
];
---

<section class="hero" id="top">
  <div class="container">
    <p class="eyebrow eyebrow--rule">SenlightAI &middot; Affective AI research</p>

    <h1 class="display-xl hero-title">
      A model that listens to <span class="serif-em">tone</span>, not just text.
    </h1>

    <p class="body-lg hero-lead">
      Mapping human emotion to Valence, Arousal, and Dominance, then training a
      language model to reward empathy over correctness. The space below is
      live: drag the sliders, click a state.
    </p>

    <div class="hero-actions">
      <a class="btn" href="#vad-model">Explore the 3D VAD space</a>
      <a class="text-link" href="/research">
        Read the documentation <span class="text-link-arrow">→</span>
      </a>
    </div>

    <dl class="spec" style="margin: 0">
      {
        spec.map((s) => (
          <div class="spec-row">
            <dt class="spec-key">{s.key}</dt>
            <dd class="spec-value" style="margin: 0">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>